{
  "name": "urlattice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate-types": "wrangler types --include-env=false",
    "typecheck": "npm run generate-types && tsc --noEmit && tsc --project tsconfig.cli.json",
    "configure": "tsx scripts/configure.ts",
    "key": "tsx scripts/key.ts",
    "create": "tsx apps/creator-cli/src/index.ts",
    "build": "vite build --config apps/creator-web/vite.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"*.{json,jsonc,mjs}\" README.md"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "nostr-tools": "^2.24.1"
  }
}
