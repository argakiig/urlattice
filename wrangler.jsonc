{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urlattice",
  "main": "apps/redirector/src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "urlattice.xyz/*",
      "zone_name": "urlattice.xyz",
    },
  ],
  "vars": {
    "RELAY_URLS": "wss://nos.lol,wss://relay.primal.net,wss://relay.nostr.com",
    "ALLOWED_PUBKEY": "c756092dc9d1b5be21aeeec73d2ab17d9aa858ac6aacdea68f73791c9165609c",
  },
}
